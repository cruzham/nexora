# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (direct Postgres connection, used by drizzle-kit + server queries)
DATABASE_URL=

# AI provider(s) -- server-side only, never exposed to client
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Which provider/model each pipeline stage uses (see lib/ai/providers/index.ts)
AI_MODEL_DEFAULT=claude-sonnet-4-6

# Rate limiting (optional in local dev; required in production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
